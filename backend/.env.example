# Offline AI SOC Analyst Copilot — Environment Configuration
# Copy this file to .env and adjust values as needed.
# DO NOT commit .env to version control.

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_PATH=data/soc_copilot.db

# Document ingestion
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=50

# Retrieval
TOP_K=5
MIN_SIMILARITY_THRESHOLD=0.05

# Foundry Local
FOUNDRY_APP_NAME=soc-copilot
FOUNDRY_MODEL_ALIAS=phi-3.5-mini
FOUNDRY_MAX_TOKENS=1024
FOUNDRY_TEMPERATURE=0.1
